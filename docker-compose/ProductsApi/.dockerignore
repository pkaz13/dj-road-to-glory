# .dockerignore

# Git files and directories
.git/
.gitignore
.gitattributes

# Docker files
.dockerignore
Dockerfile*
docker-compose*.yml
docker-compose*.yaml

# Build outputs and binaries
**/bin/
**/obj/
**/out/
**/publish/

# IDE and editor files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Ll]og/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
*.VisualState.xml

# NuGet packages
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# Node.js (if using npm/yarn for frontend assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*.cache

# Environment files
.env
.env.local
.env.development
.env.production

# Documentation
README.md
LICENSE
*.md
docs/

# Certificate files (for security)
*.pfx
*.p12
*.key
*.pem
*.crt

# Database files
*.mdf
*.ldf
*.db
*.sqlite

# Secrets and sensitive data
secrets/
**/appsettings.Development.json
**/appsettings.Local.json

# Backup files
*.bak
*~
